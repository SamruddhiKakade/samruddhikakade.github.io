---
// Timeline drawn at build time: an SVG with real links, so it works without JavaScript.
import type { CollectionEntry } from 'astro:content';
import { itemHref } from '../data/items';
interface Props { items: CollectionEntry<'items'>[] }
// Research papers stay off the timeline (her call, 2026-10-07): a paper is not a period of work.
const items = Astro.props.items.filter((i) => i.data.section !== 'research');

const lanes = [
  { key: 'experience', label: 'Experience' },
  { key: 'education', label: 'Education' },
  { key: 'certifications', label: 'Certifications' },
  { key: 'projects', label: 'Projects' },
].filter((l) => items.some((i) => i.data.section === l.key)); // empty lanes are hidden

const m = (s: string) => {
  const [y, mo] = s.split('-').map(Number);
  return y * 12 + (mo - 1);
};
const now = new Date();
const nowM = now.getFullYear() * 12 + now.getMonth();
const t0 = m('2019-06');
const t1 = nowM + 3;
const W = 960, left = 110, right = 16;
const x = (mm: number) => left + ((mm - t0) / (t1 - t0)) * (W - left - right);

type Mark = { href: string; title: string; x: number; x2?: number; y: number };
let y = 16;
const rows: { label: string; y: number; h: number; marks: Mark[] }[] = [];
for (const lane of lanes) {
  const laneItems = items.filter((i) => i.data.section === lane.key);
  const stack = new Map<number, number>();
  const marks: Mark[] = [];
  // Each item's periods: its main one, plus any later ones (a returning internship).
  const spans = (it: (typeof items)[number]) => {
    const s = m(it.data.start);
    const e = it.data.end === 'present' ? nowM : it.data.end ? m(it.data.end) : s;
    return [{ s, e }, ...(it.data.periods ?? []).map((p) => ({ s: m(p.start), e: m(p.end) }))];
  };
  // Dots go below any bar in the same lane, so a span never hides them.
  const base = laneItems.some((it) => spans(it).some((p) => p.e - p.s >= 2)) ? 1 : 0;
  let depth = 1;
  for (const it of laneItems) {
    const href = itemHref(it);
    const title = `${it.data.title} (${it.data.when}): ${it.data.oneLine}`;
    for (const { s, e } of spans(it)) {
      if (e - s >= 2) {
        marks.push({ href, title, x: x(s), x2: x(e), y: 0 });
      } else {
        const n = stack.get(s) ?? 0;
        stack.set(s, n + 1);
        depth = Math.max(depth, base + n + 1);
        marks.push({ href, title, x: x(s + 0.5), y: base + n });
      }
    }
  }
  const h = 14 + depth * 12;
  rows.push({ label: lane.label, y, h, marks });
  y += h + 10;
}
const H = y + 24;
const years: number[] = [];
for (let yr = 2020; yr * 12 <= t1; yr++) years.push(yr);
// A year label too close to "now" is left out, so the two never overlap.
const nearNow = (yr: number) => Math.abs(x(yr * 12) - x(nowM)) < 32;
const sectionName: Record<string, string> = {
  experience: 'Experience', research: 'Research', education: 'Education', certifications: 'Certification', projects: 'Project',
};
const byDate = [...items].sort((a, b) => b.data.start.localeCompare(a.data.start));
---
<figure class="timeline">
  <figcaption class="muted small">
    <span class="for-chart">Hover over a mark for its title, or click it to open. The gold line is today.</span>
    <span class="for-list">Every item since 2019, newest first.</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Timeline of everything since 2019">
    {rows.map((r) => (
      <g>
        <text x="0" y={r.y + 13} class="lane">{r.label}</text>
        <line x1={left} x2={W - right} y1={r.y + r.h} y2={r.y + r.h} class="rule" />
        {r.marks.map((mk) =>
          mk.x2 !== undefined ? (
            <a href={mk.href}><title>{mk.title}</title><rect x={mk.x + 2} y={r.y + 4} width={Math.max(6, mk.x2 - mk.x - 4)} height="9" rx="3" class="mark" /></a>
          ) : (
            <a href={mk.href}><title>{mk.title}</title><circle cx={mk.x} cy={r.y + 9 + mk.y * 12} r="5" class="mark" /></a>
          ),
        )}
      </g>
    ))}
    {years.map((yr) => (
      <g>
        <line x1={x(yr * 12)} x2={x(yr * 12)} y1="8" y2={H - 22} class="tick" />
        {!nearNow(yr) && <text x={x(yr * 12)} y={H - 6} class="year">{yr}</text>}
      </g>
    ))}
    <line x1={x(nowM)} x2={x(nowM)} y1="4" y2={H - 22} class="now" />
    <text x={x(nowM)} y={H - 6} class="year now-label">now</text>
  </svg>
  <ol class="vertical">
    {byDate.map((i) => (
      <li><span class="muted small">{sectionName[i.data.section]} · {i.data.when}</span> <a href={itemHref(i)}>{i.data.title}</a></li>
    ))}
  </ol>
</figure>

<style>
  .timeline {
    margin: 16px 0 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .lane,
  .year {
    font-size: 13px;
    fill: var(--muted);
    font-family: var(--font-body), system-ui, sans-serif;
  }
  .year {
    text-anchor: middle;
  }
  .rule {
    stroke: var(--border);
  }
  .tick {
    stroke: var(--border);
    stroke-dasharray: 2 4;
  }
  .mark {
    fill: var(--link);
  }
  a:hover .mark,
  a:focus .mark {
    fill: var(--link-hover);
    stroke: var(--text);
    stroke-width: 1.5;
  }
  .now {
    stroke: var(--gold);
    stroke-width: 2;
  }
  .now-label {
    fill: var(--gold);
  }
  figcaption {
    margin-bottom: 8px;
  }
  .for-list {
    display: none;
  }
  .vertical {
    display: none;
    list-style: none;
    padding: 0;
  }
  .vertical li {
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 767px) {
    svg,
    .for-chart {
      display: none;
    }
    .vertical,
    .for-list {
      display: block;
    }
  }
</style>
