---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Chips from './Chips.astro';
import { itemHref } from '../data/items';
interface Props { item: CollectionEntry<'items'> }
const { item } = Astro.props;
const d = item.data;
const href = itemHref(item);
// A real visual where one exists; otherwise a thin band naming the area (projects and course work only).
const code = d.links.find((l) => l.url.includes('github.com'));
const verify = d.links.find((l) => l.label.startsWith('Verify'));
---
<article class="card" data-areas={d.areas.join('|')} data-year={d.start.slice(0, 4)}>
  {d.cover ? <Image src={d.cover} alt="" width={560} class="cover" /> : d.areas.length > 0 && <p class="area small">{d.areas.join(' · ')}</p>}
  <h3><a class="stretch" href={href}>{d.title}</a></h3>
  <p class="meta muted small">{d.context} · {d.when}</p>
  {d.role !== d.title && <p class="role small">{d.role}</p>}
  <p class="summary">{d.summary}</p>
  <div class="above">
    {d.skills.length > 0 && <p class="skills-label muted small">Skills</p>}
    <Chips skills={d.skills.slice(0, 5)} />
    {code && <p class="small code"><a href={code.url}>Code on GitHub</a></p>}
    {verify && <p class="small code"><a href={verify.url}>{verify.label}</a></p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px 18px;
    transition: transform 200ms var(--ease);
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .card:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    border-radius: var(--radius-s);
    margin-bottom: 14px;
    background: #fff;
  }
  .area {
    margin: -16px -18px 12px;
    padding: 6px 18px;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  h3 {
    margin: 0 0 4px;
    font-family: var(--font-body), system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
  }
  h3 a {
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .meta,
  .role {
    margin: 0 0 6px;
  }
  .role {
    font-weight: 500;
  }
  .summary {
    margin: 8px 0 0;
  }
  .above {
    position: relative;
    z-index: 1;
  }
  .skills-label {
    margin: 12px 0 -6px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .code {
    margin: 10px 0 0;
  }
</style>
