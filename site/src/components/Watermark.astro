---
// Brahma Kamal corner signature: a closed bud in light mode that "blooms" in dark mode.
// Shapes are kept exactly as designed; petal fills match the page background (--bg in global.css).
---
<div class="bk-watermark" aria-hidden="true">
  <!-- Dark mode: open bloom -->
  <svg class="bk-dark" xmlns="http://www.w3.org/2000/svg" viewBox="-150 -122 150 122">
    <g fill="none" stroke="#E3C07A" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
      <g transform="translate(-72.8,-29.1) rotate(-14)">
        <path d="M0,2 C-24,-4 -52,-14 -70,-2 C-75,2 -76,8 -72,12 C-66,4 -44,-2 0,2Z" fill="#0f1b2d" />
        <path d="M0,2 C24,-4 52,-14 70,-2 C75,2 76,8 72,12 C66,4 44,-2 0,2Z" fill="#0f1b2d" />
        <path d="M0,0 C-20,-10 -44,-26 -58,-24 C-44,-18 -22,-6 0,0Z" fill="#0f1b2d" />
        <path d="M0,0 C20,-10 44,-26 58,-24 C44,-18 22,-6 0,0Z" fill="#0f1b2d" />
        <path d="M0,-30 Q-18,-54 -22,-72 M0,-30 Q-10,-60 -7,-80 M0,-30 Q-2,-64 2,-85 M0,-30 Q2,-62 13,-78 M0,-30 Q6,-56 24,-68" />
        <ellipse cx="-23" cy="-75" rx="2" ry="3.5" transform="rotate(-15 -23 -75)" />
        <ellipse cx="-7" cy="-83" rx="2" ry="3.5" />
        <ellipse cx="2.5" cy="-88" rx="2" ry="3.5" />
        <ellipse cx="14" cy="-81" rx="2" ry="3.5" transform="rotate(30 14 -81)" />
        <ellipse cx="26" cy="-70" rx="2" ry="3.5" transform="rotate(55 26 -70)" />
        <path d="M0,0 C-26,-12 -40,-36 -40,-56 C-28,-42 -14,-20 0,0Z" fill="#0f1b2d" />
        <path d="M0,0 C26,-12 40,-36 40,-56 C28,-42 14,-20 0,0Z" fill="#0f1b2d" />
        <path d="M0,-2 C-18,-18 -26,-44 -20,-62 C-14,-48 -7,-24 0,-2Z" fill="#0f1b2d" />
        <path d="M0,-2 C18,-18 26,-44 20,-62 C14,-48 7,-24 0,-2Z" fill="#0f1b2d" />
        <path d="M0,0 C-11,-24 -9,-52 0,-68 C9,-52 11,-24 0,0Z" fill="#0f1b2d" />
        <path d="M0,0 C-4,6 -4,14 0,18 C4,14 4,6 0,0" fill="#0f1b2d" />
      </g>
    </g>
  </svg>

  <!-- Light mode: closed bud -->
  <svg class="bk-light" xmlns="http://www.w3.org/2000/svg" viewBox="-150 -122 150 122">
    <g fill="none" stroke="#6B4FA8" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M0,0 C-14,0 -32,1 -39.5,-0.6" />
      <g transform="translate(-43.9,-18.1) rotate(-14)">
        <path d="M0,2 C-18,0 -34,-6 -42,2 C-44,5 -42,9 -39,9 C-32,2 -16,4 0,2Z" fill="#fbf7ee" />
        <path d="M0,2 C18,0 34,-6 42,2 C44,5 42,9 39,9 C32,2 16,4 0,2Z" fill="#fbf7ee" />
        <path d="M0,0 C-20,-14 -22,-50 -4,-82 C-2,-79 2,-79 4,-82 C22,-50 20,-14 0,0Z" fill="#fbf7ee" />
        <path d="M0,-2 C-10,-24 -10,-56 -4,-82 M0,-2 C10,-24 10,-56 4,-82" />
        <path d="M0,2 C-22,-4 -30,-24 -24,-46 C-20,-30 -12,-12 0,2Z" fill="#fbf7ee" />
        <path d="M0,2 C22,-4 30,-24 24,-46 C20,-30 12,-12 0,2Z" fill="#fbf7ee" />
        <path d="M0,0 C-4,6 -4,14 0,18 C4,14 4,6 0,0" fill="#fbf7ee" />
      </g>
    </g>
  </svg>
</div>

<style>
  .bk-watermark {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 36px;
    z-index: 0; /* page content sits above */
    pointer-events: none;
    line-height: 0;
  }
  .bk-watermark svg {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    transition: opacity 0.5s ease;
  }
  .bk-watermark path,
  .bk-watermark ellipse {
    vector-effect: non-scaling-stroke; /* 1px lines at any size */
  }

  /* Light (default): the bud. Opacity is on the whole SVG so hidden parts stay hidden. */
  .bk-light {
    opacity: 0.2; /* raised from 0.11: the amethyst line was almost invisible on cream */
  }
  .bk-dark {
    opacity: 0;
  }

  /* Dark: the bloom. */
  :global(:root[data-theme='dark']) .bk-light {
    opacity: 0;
  }
  :global(:root[data-theme='dark']) .bk-dark {
    opacity: 0.14;
  }
  /* Without JavaScript, follow the device setting, as the rest of the site does. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .bk-light {
      opacity: 0;
    }
    :global(:root:not([data-theme])) .bk-dark {
      opacity: 0.14;
    }
  }

  @media (max-width: 640px) {
    .bk-watermark {
      width: 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bk-watermark svg {
      transition: none;
    }
  }
  @media print {
    .bk-watermark {
      display: none;
    }
  }
</style>
