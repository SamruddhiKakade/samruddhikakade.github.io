---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { sections } from '../data/site';
import { publishedItems } from '../data/items';

const items = await publishedItems();
---
<Base title="Overview" current="overview" wide description="Selected work by Samruddhi Kakade, by section, with a timeline of everything.">
  <h1>Overview</h1>
  <p class="lead">Selected work, by section. Open a section for everything in it, or an item for its full page. The timeline at the end shows every item.</p>
  <nav class="jump small" aria-label="Sections on this page">
    <span class="muted">Jump to</span>
    <ul>
      {sections.map((s) => <li><a href={`#${s.key}`}>{s.label}</a></li>)}
      <li><a href="#timeline">Timeline</a></li>
    </ul>
  </nav>

  {sections.map((s) => {
    const all = items.filter((i) => i.data.section === s.key);
    let list = all;
    // Education: the degree always leads; selected course pieces follow as a muted sub-list.
    const courseWork = s.key === 'education' ? all.filter((i) => i.data.course && i.data.selected) : [];
    if (s.key === 'education') list = all.filter((i) => !i.data.course);
    // Projects: only the selected ones here; the Projects page has them all.
    if (s.key === 'projects') list = all.filter((i) => i.data.selected);
    const shown = list.length + courseWork.length;
    const row = (i: (typeof items)[number]) => (
      <li>
        <a href={`/${i.data.section}/${i.id}/`}>{i.data.title}</a>
        <span class="muted small"> · {i.data.context} · {i.data.when}</span>
        <p>{i.data.oneLine}</p>
      </li>
    );
    return (
      <section class="block" id={s.key}>
        <h2><a href={s.href}>{s.label}</a>{shown > 0 && <span class="count muted"> ({shown < all.length ? `${shown} of ${all.length}` : all.length})</span>}</h2>
        {list.length === 0 ? <p class="muted">{s.line}</p> : (
          <ul class="items">{list.map(row)}</ul>
        )}
        {courseWork.length > 0 && (
          <>
            <h3 class="sub muted">Course writing</h3>
            <ul class="items minor">{courseWork.map(row)}</ul>
          </>
        )}
        {shown < all.length && <p class="all"><a href={s.href}>All {all.length} on the {s.label} page</a></p>}
      </section>
    );
  })}

  <section class="block" id="timeline">
    <h2>Timeline</h2>
    <Timeline items={items} />
  </section>
</Base>

<style>
  .lead {
    max-width: var(--measure);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-top: 12px;
  }
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .block {
    scroll-margin-top: 16px;
  }
  @media (max-width: 1023px) {
    .block {
      scroll-margin-top: 64px;
    }
  }
  .sub {
    font-family: var(--font-body), system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 20px 0 0;
  }
  .minor a {
    font-weight: 400;
  }
  .minor p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .block h2 {
    margin: 40px 0 8px;
  }
  .block h2 a {
    text-decoration: none;
  }
  .count {
    font-family: var(--font-body), system-ui, sans-serif;
    font-size: 1rem;
  }
  .items {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
  }
  .items li {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .items a {
    font-weight: 500;
  }
  .items p {
    margin: 2px 0 0;
  }
  .all {
    margin: 10px 0 0;
  }
</style>
