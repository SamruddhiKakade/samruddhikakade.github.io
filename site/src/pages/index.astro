---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/photo.png';
import { person } from '../data/site';
import { publishedItems } from '../data/items';

const all = await publishedItems();
// "Latest" appears only once a research paper is published on the site (from the day it is public).
const latest = all.find((i) => i.data.section === 'research');
---
<Base current="home">
  <section class="hero">
    <div class="who">
      <div class="sky" aria-hidden="true"></div>
      <div class="glow"><Image src={photo} alt={person.name} width={320} height={320} class="photo" loading="eager" /></div>
      <div>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
        <p class="muted place">{person.location}</p>
      </div>
    </div>
    <p class="intro">
      I am an AI engineer and independent researcher focused on evaluating large language models. My research
      examines how models behave during tasks, whether repeated runs agree, and how reliable evaluation judgements
      are. Since January 2025 I have worked as an AI engineer on projects for Johnson &amp; Johnson, developing data-ingestion pipelines
      for retrieval-augmented healthcare chatbots. I earned a Master of Artificial Intelligence and a B.S. in
      Computer Science from Illinois Institute of Technology in May 2024.
    </p>
    {latest && (
      <p class="latest"><span class="muted">Latest preprint:</span> <a href={`/research/${latest.id}/`}>{latest.data.title.split(':')[0]}</a></p>
    )}
    <ul class="contact-row">
      <li><a href="/research/">Research</a></li>
      <li><a href={`mailto:${person.email}`}>Email</a></li>
      <li><a href={person.linkedin}>LinkedIn</a></li>
    </ul>
  </section>
</Base>

<style>
  /* Dark mode: a faint static starfield behind the photo, name and title, ending before the intro (her call,
     2026-10-06). Light mode: a soft amethyst glow behind the photo only. */
  .sky {
    position: absolute;
    inset: -64px -48px -12px; /* up to the page top and out to the column edges */
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    mask-image: linear-gradient(to bottom, #000 70%, transparent); /* fades out above the intro */
    background-image:
      radial-gradient(3.5px 3.5px at 90% 26%, #fff 25%, rgba(203, 188, 240, 0.35) 55%, transparent),
      radial-gradient(3.5px 3.5px at 71% 64%, #fff 25%, rgba(203, 188, 240, 0.35) 55%, transparent),
      radial-gradient(3.5px 3.5px at 47% 12%, #fff 25%, rgba(203, 188, 240, 0.35) 55%, transparent),
      radial-gradient(3.5px 3.5px at 28% 80%, #fff 25%, rgba(203, 188, 240, 0.35) 55%, transparent),
      radial-gradient(3.5px 3.5px at 6% 22%, #fff 25%, rgba(203, 188, 240, 0.35) 55%, transparent),
      radial-gradient(1.6px 1.6px at 3% 21%, #fff 60%, transparent),
      radial-gradient(1.6px 1.6px at 8% 19%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 14% 9%, #fff 60%, transparent),
      radial-gradient(1.4px 1.4px at 23% 14%, #f3e3b0 60%, transparent),
      radial-gradient(0.8px 0.8px at 29% 6%, #cbbcf0 60%, transparent),
      radial-gradient(1.2px 1.2px at 47% 18%, #fff 60%, transparent),
      radial-gradient(1.6px 1.6px at 53% 15%, #fff 60%, transparent),
      radial-gradient(1px 1px at 65% 14%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 71% 8%, #fff 60%, transparent),
      radial-gradient(0.8px 0.8px at 88% 3%, #fff 60%, transparent),
      radial-gradient(1.4px 1.4px at 95% 10%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 2% 41%, #fff 60%, transparent),
      radial-gradient(1px 1px at 12% 43%, #fff 60%, transparent),
      radial-gradient(1.6px 1.6px at 13% 37%, #fff 60%, transparent),
      radial-gradient(1px 1px at 22% 31%, #fff 60%, transparent),
      radial-gradient(0.8px 0.8px at 28% 47%, #fff 60%, transparent),
      radial-gradient(0.8px 0.8px at 36% 34%, #fff 60%, transparent),
      radial-gradient(1px 1px at 42% 40%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 51% 40%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 66% 28%, #fff 60%, transparent),
      radial-gradient(1px 1px at 74% 37%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 76% 46%, #cbbcf0 60%, transparent),
      radial-gradient(1.4px 1.4px at 85% 39%, #cbbcf0 60%, transparent),
      radial-gradient(0.8px 0.8px at 90% 30%, #fff 60%, transparent),
      radial-gradient(1.4px 1.4px at 98% 35%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 2% 56%, #fff 60%, transparent),
      radial-gradient(1px 1px at 10% 65%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 14% 53%, #fff 60%, transparent),
      radial-gradient(1px 1px at 20% 58%, #fff 60%, transparent),
      radial-gradient(1px 1px at 34% 67%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 40% 60%, #f3e3b0 60%, transparent),
      radial-gradient(1.2px 1.2px at 53% 67%, #fff 60%, transparent),
      radial-gradient(1px 1px at 65% 53%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 71% 66%, #cbbcf0 60%, transparent),
      radial-gradient(0.8px 0.8px at 80% 70%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 85% 65%, #fff 60%, transparent),
      radial-gradient(1.6px 1.6px at 96% 59%, #fff 60%, transparent),
      radial-gradient(0.8px 0.8px at 1% 93%, #fff 60%, transparent),
      radial-gradient(1.6px 1.6px at 20% 93%, #fff 60%, transparent),
      radial-gradient(1px 1px at 35% 82%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 43% 87%, #fff 60%, transparent),
      radial-gradient(1px 1px at 45% 86%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 54% 84%, #fff 60%, transparent),
      radial-gradient(1px 1px at 61% 78%, #f3e3b0 60%, transparent),
      radial-gradient(1.2px 1.2px at 64% 87%, #f3e3b0 60%, transparent),
      radial-gradient(1.2px 1.2px at 71% 88%, #cbbcf0 60%, transparent),
      radial-gradient(0.8px 0.8px at 79% 84%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 85% 83%, #fff 60%, transparent),
      radial-gradient(1.6px 1.6px at 88% 80%, #fff 60%, transparent),
      radial-gradient(0.8px 0.8px at 96% 93%, #f3e3b0 60%, transparent);
  }
  :global(:root[data-theme='dark']) .sky {
    opacity: 0.75;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sky {
      opacity: 0.75;
    }
  }
  .hero {
    padding-top: 14px;
  }
  .who {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 32px;
  }
  .glow {
    flex: 0 0 auto;
    border-radius: 50%;
    padding: 4px;
    background: var(--gold);
    box-shadow: 0 0 0 0 transparent;
  }
  :global(:root[data-theme='light']) .glow,
  :global(:root:not([data-theme])) .glow {
    box-shadow: 0 0 60px 18px rgba(107, 74, 160, 0.14);
  }
  .photo {
    display: block;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 3px solid var(--bg);
  }
  h1 {
    font-size: 3.2rem;
    margin: 0 0 6px;
    padding-bottom: 10px;
    background: linear-gradient(var(--gold), var(--gold)) left bottom / 56px 2px no-repeat;
  }
  .role {
    font-size: 1.2rem;
    margin: 0 0 2px;
  }
  .place {
    margin: 0;
  }
  .intro {
    font-size: 1.15rem;
    max-width: 66ch;
  }
  .latest {
    margin-bottom: 6px;
  }
  .contact-row {
    margin-bottom: 0;
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
  }
  /* On a wide screen the stars run on to the right edge of the window. */
  @media (min-width: 1024px) {
    .sky {
      right: auto;
      width: calc(100vw - var(--band-w));
    }
    :global(body) {
      overflow-x: clip;
    }
  }
  @media (max-width: 1023px) {
    .sky {
      inset: -56px -16px -12px;
    }
  }
  @media (max-width: 767px) {
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .photo {
      width: 120px;
      height: 120px;
    }
    h1 {
      font-size: 2.3rem;
    }
  }
</style>
