---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/photo.png';
import { person, sections } from '../data/site';
import { publishedItems } from '../data/items';

const all = await publishedItems();
// "Latest" appears only once a research paper is published on the site (from the arXiv day).
const latest = all.find((i) => i.data.section === 'research');
// Every menu option, one click from Home (the menu folds away below 1024px).
const links = [{ label: 'Overview', href: '/overview/' }, ...sections];
---
<Base current="home">
  <section class="hero">
    <div class="who">
      <div class="sky" aria-hidden="true"></div>
      <div class="glow"><Image src={photo} alt={person.name} width={320} height={320} class="photo" loading="eager" /></div>
      <div>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
        <p class="muted place">{person.location}</p>
      </div>
    </div>
    <p class="intro">
      As an independent researcher, I study how to evaluate large language models. Since January 2025 I have
      worked as an AI engineer for the client Johnson &amp; Johnson, building the data-ingestion pipelines behind
      retrieval-augmented chatbots for healthcare knowledge. I earned a Master of Artificial Intelligence and a
      B.S. in Computer Science from Illinois Institute of Technology in May 2024.
    </p>
    <ul class="proof">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    {latest && (
      <p class="latest"><span class="muted">Latest:</span> <a href={`/research/${latest.id}/`}>{latest.data.title}</a></p>
    )}
    <ul class="contact-row">
      <li><a href={`mailto:${person.email}`}>Email</a></li>
      <li><a href={person.github}>GitHub</a></li>
      <li><a href={person.linkedin}>LinkedIn</a></li>
    </ul>
  </section>
</Base>

<style>
  /* Dark mode: a faint static starfield behind the photo, name and title, ending before the intro (her call,
     2026-10-06). Light mode: a soft amethyst glow behind the photo only. */
  .sky {
    position: absolute;
    inset: -24px 0 -12px;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background-image:
      radial-gradient(1.2px 1.2px at 6% 30%, #fff 60%, transparent),
      radial-gradient(1px 1px at 17% 70%, #cbbcf0 60%, transparent),
      radial-gradient(1.4px 1.4px at 29% 20%, #fff 60%, transparent),
      radial-gradient(1px 1px at 41% 60%, #fff 60%, transparent),
      radial-gradient(1.2px 1.2px at 53% 35%, #cbbcf0 60%, transparent),
      radial-gradient(1px 1px at 64% 80%, #fff 60%, transparent),
      radial-gradient(1.4px 1.4px at 76% 25%, #fff 60%, transparent),
      radial-gradient(1px 1px at 88% 55%, #cbbcf0 60%, transparent),
      radial-gradient(1.2px 1.2px at 96% 15%, #fff 60%, transparent);
  }
  :global(:root[data-theme='dark']) .sky {
    opacity: 0.55;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sky {
      opacity: 0.55;
    }
  }
  .hero {
    padding-top: 24px;
  }
  .who {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 32px;
  }
  .glow {
    flex: 0 0 auto;
    border-radius: 50%;
    padding: 4px;
    background: var(--gold);
    box-shadow: 0 0 0 0 transparent;
  }
  :global(:root[data-theme='light']) .glow,
  :global(:root:not([data-theme])) .glow {
    box-shadow: 0 0 60px 18px rgba(107, 74, 160, 0.14);
  }
  .photo {
    display: block;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 3px solid var(--bg);
  }
  h1 {
    font-size: 3.2rem;
    margin: 0 0 6px;
    padding-bottom: 10px;
    background: linear-gradient(var(--gold), var(--gold)) left bottom / 56px 2px no-repeat;
  }
  .role {
    font-size: 1.2rem;
    margin: 0 0 2px;
  }
  .place {
    margin: 0;
  }
  .intro {
    font-size: 1.15rem;
    max-width: 62ch;
  }
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    font-size: 1.05rem;
  }
  .proof li:not(:last-child)::after {
    content: '·';
    color: var(--muted);
    margin: 0 10px;
  }
  .contact-row {
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
  }
  @media (max-width: 767px) {
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .photo {
      width: 120px;
      height: 120px;
    }
    h1 {
      font-size: 2.3rem;
    }
  }
</style>
