---
import Base from '../../layouts/Base.astro';
import { courses } from '../../data/courses';
import { publishedItems } from '../../data/items';

const all = await publishedItems();
const degree = all.filter((i) => i.data.section === 'education' && !i.data.course);
const byCourse = courses
  .map((c) => ({ ...c, items: all.filter((i) => i.data.course === c.code) }))
  .filter((c) => c.items.length > 0);
---
<Base title="Education" current="education" description="Samruddhi Kakade's degrees from Illinois Institute of Technology and the work from her courses.">
  <h1>Education</h1>
  {degree.map((d) => (
    <section class="degree">
      <h2><a href={`/education/${d.id}/`}>{d.data.title}</a></h2>
      <p class="muted small">{d.data.context} · {d.data.when}</p>
      <p>{d.data.summary}</p>
    </section>
  ))}
  <h2>Work from my courses</h2>
  <p class="muted">Every course with a project or written piece on this site, newest first.</p>
  {byCourse.map((c) => (
    <section class="course">
      <h3>{c.code.replace(/ \(.*\)$/, '')} {c.name} <span class="muted small">· {c.term}</span></h3>
      <ul>
        {c.items.map((i) => (
          <li><a href={`/${i.data.section}/${i.id}/`}>{i.data.title}</a> <span class="muted small">{i.data.oneLine}</span></li>
        ))}
      </ul>
    </section>
  ))}
</Base>
<style>
  .degree { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 4px 20px 8px; }
  .degree h2 { margin-top: 16px; font-size: 1.35rem; }
  .degree h2 a { text-decoration: none; }
  .course h3 { font-family: var(--font-body), system-ui, sans-serif; font-weight: 600; font-size: 1.05rem; margin: 28px 0 6px; }
  .course ul { padding-left: 18px; margin: 0; }
  .course li { margin: 4px 0; }
  .course li span { display: block; }
</style>
