---
import Base from '../../layouts/Base.astro';
import { courses, additionalCourses } from '../../data/courses';
import { publishedItems } from '../../data/items';

const all = await publishedItems();
const degree = all.filter((i) => i.data.section === 'education' && !i.data.course);
const withItems = courses
  .map((c) => ({ ...c, items: all.filter((i) => i.data.course === c.code) }))
  .filter((c) => c.items.length > 0);
// Graduate work first; newest first within each group.
const groups = ['Graduate', 'Undergraduate'].map((level) => ({
  level,
  courses: withItems.filter((c) => c.level === level),
}));
---
<Base title="Education at Illinois Institute of Technology" current="education" description="Samruddhi Kakade's Master of Artificial Intelligence and B.S. Computer Science from Illinois Tech, with projects and writing from her courses.">
  <h1>Education</h1>
  <p class="lead">My degrees, then the projects and written work from my courses, graduate first. Open a title for details.</p>
  {degree.map((d) => (
    <section class="degree">
      <h2>{d.data.title}</h2>
      <p class="muted small">{d.data.context} · {d.data.when}</p>
      <p>{d.data.summary}</p>
    </section>
  ))}
  {groups.map((g) => g.courses.length > 0 && (
    <section class="group">
      <h2>{g.level} coursework</h2>
      {g.courses.map((c) => (
        <section class="course">
          <h3>{c.name} <span class="muted small">· {c.code.replace(/ \(.*\)$/, '')} · {c.term}</span></h3>
          <ul>
            {c.items.map((i) => (
              <li><a href={`/${i.data.section}/${i.id}/`}>{i.data.title}</a> <span class="muted">{i.data.oneLine}</span></li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  ))}
  <section class="group">
    <h2>Additional coursework</h2>
    <p class="muted">Further courses, with no project or written piece on this site.</p>
    <dl class="extra">
      {['Graduate', 'Undergraduate'].map((level) => (
        <div>
          <dt>{level}</dt>
          <dd>{additionalCourses.filter((c) => c.level === level).map((c) => `${c.name} (${c.code})`).join(', ')}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>
<style>
  .lead { max-width: var(--measure); }
  .degree { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 4px 20px 8px; }
  .degree h2 { margin-top: 16px; font-size: 1.35rem; }
  .course h3 { font-family: var(--font-body), system-ui, sans-serif; font-weight: 600; font-size: 1.05rem; margin: 28px 0 6px; }
  .course ul { padding-left: 18px; margin: 0; }
  .course li { margin: 4px 0; }
  .course li span { display: block; }
  .extra { max-width: var(--measure); margin: 0; }
  .extra div { padding: 8px 0; border-bottom: 1px solid var(--border); }
  .extra dt { font-weight: 600; }
  .extra dd { margin: 2px 0 0; }
</style>
